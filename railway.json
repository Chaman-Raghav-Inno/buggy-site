{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": ["buggy_shop/**", "railway.json", "railpack.json", "requirements.txt", "pyproject.toml"]
  },
  "deploy": {
    "startCommand": "python -m buggy_shop",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE"
  }
}
